[sub_resource type="GDScript" id="GDScript_f43vj"]
resource_name = "Movements"
script/source = "# Player.gd
extends CharacterBody2D

# --- Top-Down Movement Parameters ---
@export var base_max_speed: float = 200.0
@export var acceleration: float = 1200.0  # Controls how quickly you reach max speed
@export var friction: float = 800.0       # Controls smooth deceleration/stopping

# --- Rocket Thruster & Gravity Parameters ---
@export var base_max_fuel: float = 2.0
@export var boost_accel: float = -900.0   # Smooth upward thrust (no instant jump)
@export var rising_gravity: float = 600.0  # Lower gravity while thrusting up
@export var base_falling_gravity: float = 1800.0 # High gravity for a snappy, fast fall
@export var max_fall_speed: float = 800.0 # Terminal velocity cap
@export var fall_limit_y: float = 1000.0  # Y position threshold that triggers Level Lost

# Effective stats modified by upgrades
var max_speed: float
var max_fuel: float
var falling_gravity: float

var current_fuel: float
var is_boosting: bool = false

@onready var sprite: AnimatedSprite2D = $AnimatedSprite2D

func _ready() -> void:
	# Add player to group so coins and desktop UI can find it
	add_to_group(\"Player\")
	apply_upgrades()

func apply_upgrades() -> void:
	# Booster level increases max fuel capacity
	max_fuel = base_max_fuel + ((GameData.booster_level - 1) * 0.75)
	current_fuel = max_fuel

	# Teleport level slightly increases max horizontal speed
	max_speed = base_max_speed + ((GameData.teleport_level - 1) * 25.0)

	# Hint level reduces falling gravity for smoother control
	falling_gravity = max(600.0, base_falling_gravity - ((GameData.hint_level - 1) * 150.0))

func _physics_process(delta: float) -> void:
	handle_smooth_movement(delta)
	handle_rocket_thrust(delta)
	update_animations()
	move_and_slide()
	
	# Check if player fell below the map
	if global_position.y > fall_limit_y:
		game_over()

func game_over() -> void:
	get_tree().change_scene_to_file(\"res://scene/computer/apps/spaceRPG/LevelLost.tscn\")

func handle_smooth_movement(delta: float) -> void:
	# Get 8-way directional input
	var input_vector := Input.get_vector(\"ui_left\", \"ui_right\", \"ui_up\", \"ui_down\")
	
	if input_vector != Vector2.ZERO:
		# Smoothly accelerate towards target velocity instead of snapping
		velocity.x = move_toward(velocity.x, input_vector.x * max_speed, acceleration * delta)
		# Allow smooth horizontal/vertical movement blending on ground or air
		if is_on_floor() or not is_boosting:
			velocity.y = move_toward(velocity.y, input_vector.y * max_speed, acceleration * delta)
	else:
		# Apply friction to smoothly slide to a stop
		velocity.x = move_toward(velocity.x, 0.0, friction * delta)
		if is_on_floor():
			velocity.y = move_toward(velocity.y, 0.0, friction * delta)

func handle_rocket_thrust(delta: float) -> void:
	# Holding jump ignites thrusters smoothly
	if Input.is_action_pressed(\"ui_accept\") and current_fuel > 0:
		is_boosting = true
		current_fuel -= delta
		# Apply continuous upward acceleration instead of an instant pop
		velocity.y += boost_accel * delta
	else:
		is_boosting = false

	# --- Gravity Handling ---
	if not is_on_floor():
		if velocity.y > 0:
			# Falling: Apply strong gravity for a fast, crisp descent
			velocity.y += falling_gravity * delta
		else:
			# Rising: Apply lighter gravity for smooth rocket ascension
			velocity.y += rising_gravity * delta
			
		# Cap peak falling speed
		velocity.y = min(velocity.y, max_fall_speed)
	else:
		# Recharge fuel when grounded
		current_fuel = move_toward(current_fuel, max_fuel, delta * 3.0)

func update_animations() -> void:
	if sprite == null:
		return

	# Play floating animation when moving or boosting
	if velocity.length() > 10.0 or is_boosting:
		if sprite.sprite_frames.has_animation(\"floating\"):
			sprite.play(\"floating\")
			
		# Automatically flip sprite horizontal orientation based on movement direction
		if velocity.x != 0:
			sprite.flip_h = velocity.x < 0
	else:
		if sprite.sprite_frames.has_animation(\"idle\"):
			sprite.play(\"idle\")
"

