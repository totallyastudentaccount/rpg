[sub_resource type="GDScript" id="GDScript_8xrg0"]
resource_name = "FuelBox"
script/source = "extends Area2D

@export var anagram_word: String = \"SPACE\"
@export var scrambled_word: String = \"CAPSE\"

var is_activated: bool = false

signal open_puzzle(scrambled: String, answer: String, box_ref: Area2D)

func _ready() -> void:
	body_entered.connect(_on_body_entered)

func _on_body_entered(body: Node2D) -> void:
	print(\"--- COLLISION DETECTED ---\")
	print(\"Node touched box: \", body.name)
	print(\"Is node in 'Player' group? \", body.is_in_group(\"Player\"))
	
	if body.is_in_group(\"Player\") and not is_activated:
		print(\"Player validated! Emitting open_puzzle signal...\")
		open_puzzle.emit(scrambled_word, anagram_word, self)
	elif is_activated:
		print(\"FuelBox is already activated.\")
	else:
		print(\"Collision ignored because node is missing the 'Player' group.\")

func activate() -> void:
	is_activated = true
	$Sprite2D.modulate = Color(0, 1, 0)
	print(\"Fuel Box activated successfully!\")
"

