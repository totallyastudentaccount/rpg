[gd_scene format=3 uid="uid://cb4gudefl7tmb"]

[sub_resource type="GDScript" id="GDScript_8olf6"]
resource_name = "LevelWon"
script/source = "# LevelWon.gd
extends Control

# Update this path if LevelWon needs to dynamically know the next scene
@export_file(\"*.tscn\") var next_level_path: String = \"res://scene/computer/apps/spaceRPG/level2.tscn\"

func _on_next_level_button_pressed() -> void:
	if next_level_path != \"\":
		get_tree().change_scene_to_file(next_level_path)
	else:
		print(\"No next level set!\")

func _on_upgrade_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scene/computer/apps/spaceRPG/Upgrades.tscn\")

func _on_quit_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scene/computer/apps/spaceRPG/spacePC.tscn\") # Or get_tree().quit()
"

