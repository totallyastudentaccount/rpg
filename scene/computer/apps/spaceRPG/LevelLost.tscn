[gd_scene format=3 uid="uid://brm35qgbd63t8"]

[sub_resource type="GDScript" id="GDScript_3ao4k"]
resource_name = "LevelLost"
script/source = "# LevelLost.gd
extends Control

@export_file(\"*.tscn\") var current_level_path: String = \"res://scene/computer/apps/spaceRPG/spaceRPG.tscn\"

func _on_restart_button_pressed() -> void:
	# Reload current level or change to specified scene
	if current_level_path != \"\":
		get_tree().change_scene_to_file(current_level_path)
	else:
		get_tree().reload_current_scene()

func _on_upgrade_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scene/computer/apps/spaceRPG/Upgrades.tscn\")

func _on_quit_button_pressed() -> void:
	get_tree().change_scene_to_file(\"res://scene/computer/apps/spaceRPG/spacePC.tscn\")
"

