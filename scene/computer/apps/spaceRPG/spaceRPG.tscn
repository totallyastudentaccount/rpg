[sub_resource type="GDScript" id="GDScript_w8qno"]
resource_name = "GameManager"
script/source = "extends Node2D

@export var total_fuel_boxes: int = 3
@export_file(\"*.tscn\") var next_level_scene: String = \"res://scene/computer/apps/spaceRPG/level2.tscn\"

const ANAGRAM_SCENE = preload(\"res://scene/computer/apps/spaceRPG/Anagram.tscn\")

var activated_boxes_count: int = 0
@onready var canvas_layer: CanvasLayer = $CanvasLayer

func _ready() -> void:
	await get_tree().process_frame
	
	var fuel_boxes = get_tree().get_nodes_in_group(\"FuelBoxes\")
	print(\"Found fuel boxes in group: \", fuel_boxes.size())
	
	for box in fuel_boxes:
		if box.has_signal(\"open_puzzle\"):
			if not box.open_puzzle.is_connected(_on_open_puzzle):
				box.open_puzzle.connect(_on_open_puzzle)
		else:
			print(\"Warning: Node in FuelBoxes group missing open_puzzle signal: \", box.name)

func _on_open_puzzle(scrambled: String, answer: String, box: Area2D) -> void:
	var puzzle_instance = ANAGRAM_SCENE.instantiate()
	canvas_layer.add_child(puzzle_instance)
	
	puzzle_instance.puzzle_solved.connect(_on_puzzle_solved)
	puzzle_instance.start_puzzle(scrambled, answer, box)
	

func _on_puzzle_solved(_box: Area2D) -> void:
	activated_boxes_count += 1
	if activated_boxes_count >= total_fuel_boxes:
		game_win()

func game_win() -> void:
	print(\"Level Completed!\")
	var desktop = get_tree().get_first_node_in_group(\"DesktopUI\")
	
	if desktop:
		desktop.change_subviewport_scene(\"res://scene/computer/apps/spaceRPG/LevelWon.tscn\")
	else:
		get_tree().change_scene_to_file(\"res://scene/computer/apps/spaceRPG/LevelWon.tscn\")
"

